# ==============================================================================
# CineMatch Environment Variables Template
# Copy this file to .env and configure your local settings
# ==============================================================================

# Application Settings
PROJECT_NAME="CineMatch Recommendation Engine"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Backend Security
SECRET_KEY="cinematch-super-secret-development-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Database Configuration
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="cinematch_db"

# Redis Cache Configuration
REDIS_URL="redis://localhost:6379/0"
REDIS_CACHE_TTL_SECONDS=3600

# CORS Configuration (JSON array format)
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]'

# Apache Spark Settings
SPARK_APP_NAME="CineMatch-Recommender"
SPARK_MASTER="local[*]"
SPARK_DRIVER_MEMORY="4g"
SPARK_EXECUTOR_MEMORY="4g"
